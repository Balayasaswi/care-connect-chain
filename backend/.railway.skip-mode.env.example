# Railway variables for APP-WORKS-NOW mode (blockchain optional)
# Use this when you want full app flow without blocking on faucet/deploy.

# Core app
GROQ_API_KEY=your_groq_key
HOST=0.0.0.0
PORT=5000

# IPFS cloud mode
IPFS_PROVIDER=pinata
PINATA_JWT=your_pinata_jwt
IPFS_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
IPFS_READ_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://ipfs.io/ipfs

# Blockchain soft-fail mode
BLOCKCHAIN_OPTIONAL=true

# Leave blockchain vars unset in this mode:
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_PRIVATE_KEY=
# CID_REGISTRY_CONTRACT_ADDRESS=
# BLOCKCHAIN_CHAIN_ID=
