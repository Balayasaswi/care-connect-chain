GROQ_API_KEY=your_groq_api_key_here
PORT=5000
HOST=0.0.0.0

# IPFS mode
# Use `local` for laptop demos only.
# Use `pinata` on Railway.
IPFS_PROVIDER=pinata
IPFS_API_BASE=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
IPFS_READ_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://ipfs.io/ipfs

PINATA_JWT=your_pinata_jwt_here
# Or use API key + secret instead of JWT
# PINATA_API_KEY=your_pinata_api_key_here
# PINATA_API_SECRET=your_pinata_api_secret_here

# Blockchain (set public RPC for Railway; localhost only for local chain)
# BLOCKCHAIN_RPC_URL=https://your-testnet-rpc
# BLOCKCHAIN_PRIVATE_KEY=0xYourWalletPrivateKey
# CID_REGISTRY_CONTRACT_ADDRESS=0xDeployedContractAddress
# BLOCKCHAIN_CHAIN_ID=80002
# BLOCKCHAIN_OPTIONAL=true
