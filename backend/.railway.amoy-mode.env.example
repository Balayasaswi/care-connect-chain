# Railway variables for REAL TESTNET BLOCKCHAIN mode (free Amoy)

# Core app
GROQ_API_KEY=your_groq_key
HOST=0.0.0.0
PORT=5000

# IPFS cloud mode
IPFS_PROVIDER=pinata
PINATA_JWT=your_pinata_jwt
IPFS_GATEWAY_BASE=https://gateway.pinata.cloud/ipfs
IPFS_READ_GATEWAYS=https://gateway.pinata.cloud/ipfs,https://ipfs.io/ipfs

# Blockchain testnet mode
BLOCKCHAIN_OPTIONAL=true
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
CID_REGISTRY_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT
BLOCKCHAIN_CHAIN_ID=80002
