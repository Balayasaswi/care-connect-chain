# Copy to backend/.env.amoy (local reference only; do not commit real private key)

# Free RPC from Alchemy/Infura/Ankr for Polygon Amoy testnet
BLOCKCHAIN_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY

# Test wallet private key only (never main wallet)
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY

# Polygon Amoy chain id
BLOCKCHAIN_CHAIN_ID=80002

# Filled after deployment
CID_REGISTRY_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT

# Keep blockchain proof optional in backend behavior
BLOCKCHAIN_OPTIONAL=true
