{
  "name": "care-connect-chain",
  "version": "1.0.0",
  "description": "Care Connect Chain - Blockchain-based care coordination",
  "type": "module",
  "scripts": {
    "start": "cd backend && node server.js",
    "install-backend": "cd backend && npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend && npm run lint:contracts",
    "lint:contracts": "solhint \"contracts/**/*.sol\"",
    "typecheck": "npm run typecheck --prefix frontend",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix frontend exec eslint --fix",
      "prettier --write"
    ],
    "backend/**/*.{js,mjs,cjs}": [
      "npm --prefix backend exec eslint --fix",
      "prettier --write"
    ],
    "contracts/**/*.sol": [
      "solhint",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-solidity": "^1.4.2",
    "solhint": "^5.0.5"
  }
}
